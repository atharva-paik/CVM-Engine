let i = 1;
while (i <= 20) {
    let rem3  = i - (i / 3) * 3;
    let rem5  = i - (i / 5) * 5;
    let rem15 = i - (i / 15) * 15;
    
    if (rem15 == 0) {
        print 15;
    } else {
        if (rem3 == 0) {
            print 3;
        } else {
            if (rem5 == 0) {
                print 5;
            } else {
                print i;
            }
        }
    }
    i = i + 1;
}