let a = 10;
let b = 20;

let sum = a + b;
let diff = a - b;
let mult = a * b;
let div = b / a;
let neg = -a;
let complex = (a + 5) * 2;

print sum;     // Expected: 30
print diff;    // Expected: -10
print mult;    // Expected: 200
print div;     // Expected: 2
print neg;     // Expected: -10
print complex; // Expected: 30
